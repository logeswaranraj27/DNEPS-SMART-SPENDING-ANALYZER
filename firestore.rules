rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
    
    // User root document and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null 
          && request.auth.uid == userId
          && request.resource.data.amount > 0
          && (request.resource.data.type == 'income' || request.resource.data.type == 'expense');
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Budgets subcollection
      match /budgets/{budgetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Savings Goals subcollection
      match /savingsGoals/{goalId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Preferences subcollection (including personalized AI mode)
      match /preferences/{preferenceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

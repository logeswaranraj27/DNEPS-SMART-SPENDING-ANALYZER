# ========================================================
# SmartSpend Environment Configuration Example
# Copy this file to .env or configure in your deployment environment.
# Never commit the actual .env or service account credentials!
# ========================================================

# --- Java Spring Boot Backend Configuration ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Firebase Admin SDK Configuration (Server-Side) ---
# Path to your Firebase service account JSON file
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Alternatively, set Google Application Default Credentials:
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=smartspend-college-capstone

# --- DNEPS AI Language Model API Configuration ---
# Supported providers: GEMINI, OPENAI, or DEMO
AI_PROVIDER=GEMINI
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# --- Frontend Firebase Client Configuration ---
# Values from Firebase Console -> Project Settings -> General -> Web App
FIREBASE_API_KEY=AIzaSy...your_client_api_key
FIREBASE_AUTH_DOMAIN=smartspend-college-capstone.firebaseapp.com
FIREBASE_PROJECT_ID=smartspend-college-capstone
FIREBASE_STORAGE_BUCKET=smartspend-college-capstone.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# --- Frontend API Target URL ---
FRONTEND_BACKEND_URL=http://localhost:8080
